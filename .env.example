# MailerLite API Key
# Get your API key from: https://dashboard.mailerlite.com/integrations/api
MAILERLITE_API_KEY=your_mailerlite_api_key_here

# Articles API (for n8n automation)
# Generate a random secure key for this
ARTICLES_API_KEY=your_secure_api_key_here

# GitHub API (for auto-publishing articles)
# Create a Personal Access Token with 'repo' scope: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=cosmos510
GITHUB_REPO_NAME=blog-tech
GITHUB_BRANCH=v2-nextjs
